# ===== Konto administratora (wymagane przy pierwszym uruchomieniu) =====
ADMIN_EMAIL=twoj@email.pl
ADMIN_PASSWORD=silne-haslo-min-8-znakow

# ===== Sondy =====
# Wariant 1 (najprostszy): bazowy URL + token + lista tabel
SENSOR_BASE_URL=https://fwtw.tech/otter/api.php
SENSOR_TOKEN=vqqPass89
SENSOR_TABLES=sensor_1,sensor_2,sensor_3

# Wariant 2 (alternatywa): pełne URL-e rozdzielone przecinkami — nadpisuje wariant 1
# SENSOR_URLS=https://fwtw.tech/otter/api.php?token=...&table=sensor_1,https://...

# ===== E-mail (SMTP) — bez tego alerty nie będą wysyłane =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=twoj@gmail.com
SMTP_PASS=haslo-aplikacji
MAIL_FROM=Otter Monitor <twoj@gmail.com>

# ===== Opcjonalne =====
# Sekret sesji (gdy brak — generowany automatycznie i zapisywany w bazie)
# SESSION_SECRET=losowy-dlugi-ciag
# Publiczny adres aplikacji (link "Otwórz panel" w e-mailach)
# APP_URL=https://twoja-app.up.railway.app
# Częstotliwość odpytywania sond w sekundach (domyślnie 300 = 5 min)
# POLL_INTERVAL_SECONDS=300
# Katalog na bazę SQLite — na Railway ustaw /data i podepnij wolumen
# DATA_DIR=/data
